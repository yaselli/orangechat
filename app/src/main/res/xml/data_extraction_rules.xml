<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup disableIfNoEncryptionCapabilities="true">
    <!-- Only user-managed uploads may leave the device. DataStore credentials and Room
         databases are intentionally omitted by the allowlist. -->
    <include
      domain="file"
      path="upload/" />
  </cloud-backup>
  <device-transfer>
    <include
      domain="file"
      path="upload/" />
  </device-transfer>
</data-extraction-rules>
